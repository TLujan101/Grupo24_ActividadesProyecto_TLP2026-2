GAME_TYPE TANKS

GAME_GRID (15, 15)

# --- Tanque del jugador: identificador unico, verde, 3 de resistencia ---
DEFINE SHAPE JUGADOR TYPE: PLAYER HP 3 COLOR GREEN:
  STATE 1: [1] END

# --- Enemigos: color segun resistencia/velocidad; disparan al jugador ---
DEFINE SHAPE ENEMIGO_BASICO TYPE: ENEMY HP 2 SPEED 2 FIRE_RATE 3 COLOR RED:
  STATE 1: [1] END

DEFINE SHAPE ENEMIGO_RAPIDO TYPE: ENEMY HP 1 SPEED 4 FIRE_RATE 2 COLOR ORANGE:
  STATE 1: [1] END

DEFINE SHAPE ENEMIGO_DURO TYPE: ENEMY HP 3 SPEED 1 FIRE_RATE 4 COLOR PURPLE:
  STATE 1: [1] END

# --- Final Boss: fortaleza 2x2, mucho HP, mas dano que un tanque normal ---
DEFINE BOSS JEFE HP 20 DAMAGE 2 SPEED 3 FIRE_RATE 1 COLOR MAGENTA:
  STATE 1:
    [1, 1]
    [1, 1]
END

# --- Municion: el dano viaja en la bala (MOVE FORWARD lo hace el motor) ---
DEFINE SHAPE BALA_JUGADOR TYPE BULLET OWNER PLAYER DAMAGE 1 COLOR CYAN:
  STATE 1: [1] END
DEFINE SHAPE BALA_ENEMIGA TYPE BULLET OWNER ENEMY  DAMAGE 1 COLOR YELLOW:
  STATE 1: [1] END

DEFINE SHAPE MURO     TYPE WALL   COLOR GRAY:   STATE 1: [1] END
DEFINE SHAPE MARTILLO TYPE PICKUP HEAL 1 COLOR YELLOW: STATE 1: [1] END

# --- Musica y efectos (misma tecnica que Tetris y Snake) ---
DEFINE SONG TANK_TEMA WAVE SQUARE:
  NOTE C4 300
  NOTE C4 150
  NOTE G3 150
  NOTE A#3 300
  NOTE A#3 150
  NOTE G3 150
  NOTE A3 300
  NOTE A3 150
  NOTE F3 150
  NOTE G3 600
  NOTE C4 300
  NOTE C4 150
  NOTE D#4 150
  NOTE D4 300
  NOTE C4 150
  NOTE A#3 150
  NOTE G3 600
END

DEFINE EFFECT DISPARO:
  NOTE E5 60
  NOTE B4 60
END

DEFINE EFFECT IMPACTO:
  NOTE G3 100
  NOTE C3 150
END

DEFINE EFFECT MORIR:
  NOTE E4 150
  NOTE C4 150
  NOTE A3 400
END

LEVELS:
  START: PATRULLA
  LEVEL PATRULLA:
    TICK 0.12
    WALLS 6
    TARGET_SCORE 2000
  END
  LEVEL ASEDIO:
    TICK 0.08
    WALLS 10
    TARGET_SCORE 2000
  END
END

ON START:
  SPAWN PLAYER AT (6, 12)
  SPAWN ENEMIGO_BASICO AT (2, 2)
  SPAWN ENEMIGO_RAPIDO AT (12, 2)
  SPAWN ENEMIGO_DURO AT (2, 8)
  SPAWN MARTILLO AT RANDOM
  PLAY_MUSIC TANK_TEMA
END

ON KEY_UP:    MOVE PLAYER UP    END
ON KEY_DOWN:  MOVE PLAYER DOWN  END
ON KEY_LEFT:  MOVE PLAYER LEFT  END
ON KEY_RIGHT: MOVE PLAYER RIGHT END
ON KEY_SHOOT:
  SHOOT PLAYER
  PLAY_EFFECT DISPARO
END

ON TICK:
  MOVE FORWARD
END

ON ENEMY_DEFEATED:
  INCREASE_SCORE 100
  SPAWN ENEMY AT RANDOM
  PLAY_EFFECT IMPACTO
END

ON TARGET_SCORE 2000:
  SPAWN BOSS AT RANDOM
  PLAY_EFFECT IMPACTO
END

ON BOSS_DEFEATED:
  INCREASE_SCORE 500
  STOP_MUSIC
  PLAY_EFFECT MORIR
END

ON BULLET_HIT_WALL:
  PLAY_EFFECT IMPACTO
END

ON PLAYER_HIT:
  PLAY_EFFECT IMPACTO
END

ON EAT_HAMMER:
  HEAL PLAYER
  SPAWN MARTILLO AT RANDOM
END

ON GAME_OVER:
  STOP_MUSIC
  PLAY_EFFECT MORIR
END
