# snake_remake.brick
# Actividad 4 - Seccion C: niveles de dificultad desde la gramatica.
# Versión completa con formas geométricas, frutas venenosas, nubes y power-ups.
GAME_TYPE SNAKE

GAME_GRID (18, 18)

# --- Definicion de Elementos y Geometria ---
# Segmento con forma circular para niveles estándar o entusiastas
DEFINE SHAPE CUERPO_CIRCULAR GEOMETRY CIRCLE COLOR BLUE:
  STATE 1:
    [1]
  END
END

# Segmento con forma triangular
DEFINE SHAPE CUERPO_TRIANGULAR GEOMETRY TRIANGLE COLOR GREEN:
  STATE 1:
    [1]
  END
END

# Cabeza especial para el nivel Nyan Cat (geometría de gato/círculo)
DEFINE SHAPE CABEZA_NYAN GEOMETRY NYAN_CAT COLOR PURPLE:
  STATE 1:
    [1, 1]
    [1, 1]
  END
END

# --- Canciones ---
# Tema de Baby: lento y espacioso, registro grave.
DEFINE SONG TEMA_CALMO:
  NOTE C4 800
  NOTE E4 800
  NOTE G4 800
  NOTE E4 800
  NOTE F4 800
  NOTE A4 800
  NOTE G4 1600
END

# Tema de Entusiasta: tempo medio y mas movimiento.
DEFINE SONG TEMA_ENTUSIASTA:
  NOTE C4 300
  NOTE E4 300
  NOTE G4 300
  NOTE E4 300
  NOTE D4 300
  NOTE F4 300
  NOTE A4 300
  NOTE F4 300
  NOTE E4 300
  NOTE G4 300
  NOTE C4 300
  NOTE G4 300
  NOTE C4 600
END

# Tema Nyan Cat: tema propio de dos voces (lead + arpegio) en onda cuadrada.
# 6 compases de 4/4 a 150 BPM (corchea de 200 ms) = 9.6 s de loop.
# Progresion: C - Am - F - G - C - G7>C. Termina resolviendo en Do.
DEFINE SONG TEMA_NYAN WAVE SQUARE:
  VOICE 1:
    NOTE C5 200
    NOTE E5 200
    NOTE G5 200
    NOTE C6 200
    NOTE B5 200
    NOTE G5 200
    NOTE E5 200
    NOTE C5 200
    NOTE A4 200
    NOTE C5 200
    NOTE E5 200
    NOTE A5 200
    NOTE G5 200
    NOTE E5 200
    NOTE C5 200
    NOTE REST 200
    NOTE F4 200
    NOTE A4 200
    NOTE C5 200
    NOTE F5 200
    NOTE E5 200
    NOTE C5 200
    NOTE A4 200
    NOTE F4 200
    NOTE G4 200
    NOTE B4 200
    NOTE D5 200
    NOTE G5 200
    NOTE F#5 200
    NOTE D5 200
    NOTE B4 200
    NOTE REST 200
    NOTE C5 200
    NOTE E5 200
    NOTE G5 200
    NOTE C6 200
    NOTE E6 200
    NOTE D6 200
    NOTE C6 200
    NOTE G5 200
    NOTE B4 200
    NOTE D5 200
    NOTE F#5 200
    NOTE B5 200
    NOTE A5 200
    NOTE G5 200
    NOTE E5 200
    NOTE D5 200
  END
  VOICE 2:
    NOTE C3 200
    NOTE E3 200
    NOTE G3 200
    NOTE E3 200
    NOTE G3 200
    NOTE E3 200
    NOTE C3 200
    NOTE E3 200
    NOTE A2 200
    NOTE C3 200
    NOTE E3 200
    NOTE C3 200
    NOTE E3 200
    NOTE C3 200
    NOTE A2 200
    NOTE C3 200
    NOTE F2 200
    NOTE A2 200
    NOTE C3 200
    NOTE A2 200
    NOTE C3 200
    NOTE A2 200
    NOTE F2 200
    NOTE A2 200
    NOTE G2 200
    NOTE B2 200
    NOTE D3 200
    NOTE B2 200
    NOTE D3 200
    NOTE B2 200
    NOTE G2 200
    NOTE B2 200
    NOTE C3 200
    NOTE E3 200
    NOTE G3 200
    NOTE E3 200
    NOTE C4 200
    NOTE G3 200
    NOTE E3 200
    NOTE C3 200
    NOTE G2 200
    NOTE B2 200
    NOTE D3 200
    NOTE F3 200
    NOTE E3 200
    NOTE D3 200
    NOTE C3 200
    NOTE B2 200
  END
END

# --- Efectos ---
DEFINE EFFECT COMER:
  NOTE C6 60
  NOTE E6 60
  NOTE G6 120
END

DEFINE EFFECT VENENO:
  NOTE A3 100
  NOTE F3 150
END

DEFINE EFFECT POWERUP_FX:
  NOTE G5 100
  NOTE B5 100
  NOTE D6 200
END

DEFINE EFFECT MORIR:
  NOTE REST 120
  NOTE G5 200
  NOTE REST 60
  NOTE E5 200
  NOTE REST 60
  NOTE C5 400
END

# --- Niveles ---
# Nubes: solo Nyan Cat (el enunciado).
LEVELS:
  START: BABY
  LEVEL BABY:
    MUSIC TEMA_CALMO
    TICK 0.18
    GEOMETRY RECT
    CLOUDS_COUNT 0
  END
  LEVEL ENTUSIASTA:
    MUSIC TEMA_ENTUSIASTA
    TICK 0.12
    GEOMETRY TRIANGLE
    POISON_ENABLED TRUE
    INVULNERABILITY_DURATION 7
    CLOUDS_COUNT 0
  END
  LEVEL NYAN_CAT:
    MUSIC TEMA_NYAN
    TICK 0.06
    GEOMETRY NYAN_CAT
    POISON_ENABLED TRUE
    POISON_KILLS TRUE
    INVULNERABILITY_DURATION 5
    CLOUDS_COUNT 4
  END
END

# --- Logica y Reglas ---
ON START:
  SPAWN PLAYER AT (9, 9)
  SPAWN FOOD AT RANDOM
END

ON TICK:
  MOVE PLAYER FORWARD
END

ON EAT_FOOD:
  INCREASE_SCORE 10
  GROW PLAYER 1
  PLAY_EFFECT COMER
  SPAWN FOOD AT RANDOM
END

ON EAT_POISON:
  DECREASE_SCORE 5
  PLAY_EFFECT VENENO
  SPAWN POISON AT RANDOM
END

ON EAT_POWERUP:
  GRANT_INVULNERABILITY 7
  PLAY_EFFECT POWERUP_FX
END

ON GAME_OVER:
  PLAY_EFFECT MORIR
END

ON COLLISION_WALL:
  GAME_OVER
END

ON COLLISION_SELF:
  GAME_OVER
END

ON COLLISION_CLOUD:
  RESET_SCORE
END

# --- Controles ---
ON KEY_UP:
  SET_DIRECTION UP
END
ON KEY_DOWN:
  SET_DIRECTION DOWN
END
ON KEY_LEFT:
  SET_DIRECTION LEFT
END
ON KEY_RIGHT:
  SET_DIRECTION RIGHT
END
