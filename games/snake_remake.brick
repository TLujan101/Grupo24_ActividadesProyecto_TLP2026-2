# snake_remake.brick
# Actividad 4 - Seccion C: niveles de dificultad desde la gramatica.
# Los tres niveles se diferencian solo en la velocidad del tick. Las frutas
# venenosas, las nubes y la geometria llegan en las secciones B y A.
GAME_TYPE SNAKE

GAME_GRID (18, 18)

# --- Definicion de Elementos ---
DEFINE SHAPE PIXEL:
  STATE 1:
    [1]
END

# --- Niveles ---
# START fija el nivel con el que arranca si el jugador no elige otro. El motor
# no sabe que existe un nivel llamado NYAN_CAT: solo obedece lo que este bloque
# declara. En pantalla se muestran como '1. Baby', '2. Entusiasta' y
# '3. Nyan Cat', y se pueden elegir con clic o con las teclas 1, 2 y 3.
LEVELS:
  START: NYAN_CAT
  LEVEL BABY:
    TICK 0.15
  END
  LEVEL ENTUSIASTA:
    TICK 0.10
  END
  LEVEL NYAN_CAT:
    TICK 0.06
  END
END

# --- Logica y Reglas ---
ON START:
  SPAWN PLAYER AT (9, 9)
  SPAWN FOOD AT RANDOM
END

# ON_TICK es un evento que se ejecuta en cada ciclo del juego
ON TICK:
  MOVE PLAYER FORWARD
END

# Evento para cuando la serpiente come
ON EAT_FOOD:
  INCREASE_SCORE 10
  GROW PLAYER 1
  SPAWN FOOD AT RANDOM
END

# Eventos de fin de juego
ON COLLISION_WALL:
  GAME_OVER
END
ON COLLISION_SELF:
  GAME_OVER
END

# --- Controles ---
ON KEY_UP:
  SET_DIRECTION UP
END
ON KEY_DOWN:
  SET_DIRECTION DOWN
END
ON KEY_LEFT:
  SET_DIRECTION LEFT
END
ON KEY_RIGHT:
  SET_DIRECTION RIGHT
END