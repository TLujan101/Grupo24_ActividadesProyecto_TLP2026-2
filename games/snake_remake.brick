# snake_remake.brick
# Actividad 4 - Seccion C: niveles de dificultad desde la gramatica.
# Versión completa con formas geométricas, frutas venenosas, nubes y power-ups.
GAME_TYPE SNAKE

GAME_GRID (18, 18)

# --- Definicion de Elementos y Geometria ---
# Segmento con forma circular para niveles estándar o entusiastas
DEFINE SHAPE CUERPO_CIRCULAR GEOMETRY CIRCLE COLOR BLUE:
  STATE 1:
    [1]
  END
END

# Segmento con forma triangular
DEFINE SHAPE CUERPO_TRIANGULAR GEOMETRY TRIANGLE COLOR GREEN:
  STATE 1:
    [1]
  END
END

# Cabeza especial para el nivel Nyan Cat (geometría de gato/círculo)
DEFINE SHAPE CABEZA_NYAN GEOMETRY NYAN_CAT COLOR PURPLE:
  STATE 1:
    [1, 1]
    [1, 1]
  END
END

# --- Canciones ---
# Tema de Baby: lento y espacioso, registro grave.
DEFINE SONG TEMA_CALMO:
  NOTE C4 800
  NOTE E4 800
  NOTE G4 800
  NOTE E4 800
  NOTE F4 800
  NOTE A4 800
  NOTE G4 1600
END

# Tema de Entusiasta: tempo medio y mas movimiento.
DEFINE SONG TEMA_ENTUSIASTA:
  NOTE C4 300
  NOTE E4 300
  NOTE G4 300
  NOTE E4 300
  NOTE D4 300
  NOTE F4 300
  NOTE A4 300
  NOTE F4 300
  NOTE E4 300
  NOTE G4 300
  NOTE C4 300
  NOTE G4 300
  NOTE C4 600
END

# Tema Nyan Cat con onda cuadrada
DEFINE SONG TEMA_NYAN WAVE SQUARE:
  NOTE D#5 107
  NOTE E5 107
  NOTE F#5 107
  NOTE REST 107
  NOTE B5 107
  NOTE E5 107
  NOTE D#5 107
  NOTE E5 107
  NOTE F#5 107
  NOTE B5 107
  NOTE D6 107
  NOTE E6 107
  NOTE D#6 107
  NOTE A#5 107
  NOTE B5 107
  NOTE REST 107
END

# --- Efectos ---
DEFINE EFFECT COMER:
  NOTE C6 60
  NOTE E6 60
  NOTE G6 120
END

DEFINE EFFECT VENENO:
  NOTE A3 100
  NOTE F3 150
END

DEFINE EFFECT POWERUP_FX:
  NOTE G5 100
  NOTE B5 100
  NOTE D6 200
END

DEFINE EFFECT MORIR:
  NOTE REST 120
  NOTE G5 200
  NOTE REST 60
  NOTE E5 200
  NOTE REST 60
  NOTE C5 400
END

# --- Niveles ---
LEVELS:
  START: BABY
  LEVEL BABY:
    MUSIC TEMA_CALMO
    TICK 0.18
    GEOMETRY RECT
    CLOUDS_COUNT 0
  END
  LEVEL ENTUSIASTA:
    MUSIC TEMA_ENTUSIASTA
    TICK 0.12
    GEOMETRY TRIANGLE
    POISON_ENABLED TRUE
    INVULNERABILITY_DURATION 10
    CLOUDS_COUNT 2
  END
  LEVEL NYAN_CAT:
    MUSIC TEMA_NYAN
    TICK 0.06
    GEOMETRY NYAN_CAT
    POISON_ENABLED TRUE
    POISON_KILLS TRUE
    INVULNERABILITY_DURATION 15
    CLOUDS_COUNT 4
  END
END

# --- Logica y Reglas ---
ON START:
  SPAWN PLAYER AT (9, 9)
  SPAWN FOOD AT RANDOM
END

ON TICK:
  MOVE PLAYER FORWARD
END

ON EAT_FOOD:
  INCREASE_SCORE 10
  GROW PLAYER 1
  PLAY_EFFECT COMER
  SPAWN FOOD AT RANDOM
END

ON EAT_POISON:
  DECREASE_SCORE 5
  PLAY_EFFECT VENENO
  SPAWN POISON AT RANDOM
END

ON EAT_POWERUP:
  GRANT_INVULNERABILITY 10
  PLAY_EFFECT POWERUP_FX
  GROW PLAYER 2
  SPAWN POWERUP AT RANDOM
END

ON GAME_OVER:
  PLAY_EFFECT MORIR
END

ON COLLISION_WALL:
  GAME_OVER
END

ON COLLISION_SELF:
  GAME_OVER
END

ON COLLISION_CLOUD:
  RESET_SCORE
END

# --- Controles ---
ON KEY_UP:
  SET_DIRECTION UP
END
ON KEY_DOWN:
  SET_DIRECTION DOWN
END
ON KEY_LEFT:
  SET_DIRECTION LEFT
END
ON KEY_RIGHT:
  SET_DIRECTION RIGHT
END
