# snake_remake.brick
# Actividad 4 - Seccion C: niveles de dificultad desde la gramatica.
# Los tres niveles se diferencian en la velocidad del tick y en el tema que
# suena. Las frutas venenosas, las nubes y la geometria llegan en B y A.
GAME_TYPE SNAKE

GAME_GRID (18, 18)

# --- Definicion de Elementos ---
DEFINE SHAPE PIXEL:
  STATE 1:
    [1]
END

# --- Canciones ---
# Cada nota lleva nombre (E5) y duracion en ms. El motor las sintetiza: no hay
# ningun archivo de audio, la musica es codigo.

# Tema de Baby: lento y espacioso, registro grave.
DEFINE SONG TEMA_CALMO:
  NOTE C4 800
  NOTE E4 800
  NOTE G4 800
  NOTE E4 800
  NOTE F4 800
  NOTE A4 800
  NOTE G4 1600
END

# Tema de Entusiasta: tempo medio y mas movimiento.
DEFINE SONG TEMA_ENTUSIASTA:
  NOTE C4 300
  NOTE E4 300
  NOTE G4 300
  NOTE E4 300
  NOTE D4 300
  NOTE F4 300
  NOTE A4 300
  NOTE F4 300
  NOTE E4 300
  NOTE G4 300
  NOTE C4 300
  NOTE G4 300
  NOTE C4 600
END

# Tema de Nyan Cat: rapido y saltarin, motivo que se repite en Do mayor.
DEFINE SONG TEMA_NYAN:
  NOTE G5 150
  NOTE A5 150
  NOTE D#5 150
  NOTE E5 150
  NOTE C5 150
  NOTE D#5 150
  NOTE D5 150
  NOTE C5 300
  NOTE C5 150
  NOTE D5 150
  NOTE D#5 150
  NOTE D#5 150
  NOTE D5 150
  NOTE C5 150
  NOTE D5 150
  NOTE E5 300
  NOTE G5 150
  NOTE A5 150
  NOTE E5 150
  NOTE G5 150
  NOTE D5 150
  NOTE E5 150
  NOTE C5 150
  NOTE D#5 300
  NOTE E5 150
  NOTE D#5 150
  NOTE D5 150
  NOTE C5 150
  NOTE D5 150
  NOTE D#5 150
  NOTE C5 150
  NOTE D5 300
  NOTE E5 150
  NOTE G5 150
  NOTE D5 150
  NOTE D#5 150
  NOTE D5 150
  NOTE C5 150
  NOTE D5 150
  NOTE E5 300
  NOTE G5 150
  NOTE A5 150
  NOTE E5 150
  NOTE G5 150
  NOTE D5 150
  NOTE E5 150
  NOTE C5 150
  NOTE D#5 300
  NOTE E5 150
  NOTE D#5 150
  NOTE D5 150
  NOTE C5 150
  NOTE D5 150
  NOTE D#5 150
  NOTE C5 150
  NOTE D5 300
  NOTE E5 150
  NOTE G5 150
  NOTE D5 150
  NOTE D#5 150
  NOTE D5 150
  NOTE C5 150
  NOTE D5 150
  NOTE C5 300
  NOTE D5 150
END

# --- Efectos ---
# Un efecto suena una vez y NUNCA corta la musica de fondo.
DEFINE EFFECT COMER:
  NOTE C6 60
  NOTE E6 60
  NOTE G6 120
END

DEFINE EFFECT MORIR:
  NOTE G5 200
  NOTE E5 200
  NOTE C5 400
END

# --- Niveles ---
# START fija el nivel con el que arranca si el jugador no elige otro. El motor
# no sabe que existe un nivel llamado NYAN_CAT: solo obedece lo que este bloque
# declara. En pantalla se muestran como '1. Baby', '2. Entusiasta' y
# '3. Nyan Cat', y se pueden elegir con clic o con las teclas 1, 2 y 3.
LEVELS:
  START: NYAN_CAT
  LEVEL BABY:
    TICK 0.15
    MUSIC TEMA_CALMO
  END
  LEVEL ENTUSIASTA:
    TICK 0.10
    MUSIC TEMA_ENTUSIASTA
  END
  LEVEL NYAN_CAT:
    TICK 0.06
    MUSIC TEMA_NYAN
  END
END

# --- Logica y Reglas ---
# La musica NO se pide aqui: la pide el nivel. Si se añadiera un PLAY_MUSIC en
# este evento, mandaria sobre el tema del nivel.
ON START:
  SPAWN PLAYER AT (9, 9)
  SPAWN FOOD AT RANDOM
END

# ON_TICK es un evento que se ejecuta en cada ciclo del juego
ON TICK:
  MOVE PLAYER FORWARD
END

# Evento para cuando la serpiente come
ON EAT_FOOD:
  INCREASE_SCORE 10
  GROW PLAYER 1
  PLAY_EFFECT COMER
  SPAWN FOOD AT RANDOM
END

# El motor emite ON GAME_OVER una sola vez, tanto si choca con la pared como
# si se come a si misma: por eso el efecto de morir va aqui y no duplicado en
# los dos eventos de colision.
ON GAME_OVER:
  PLAY_EFFECT MORIR
END

# Eventos de fin de juego
ON COLLISION_WALL:
  GAME_OVER
END
ON COLLISION_SELF:
  GAME_OVER
END

# --- Controles ---
ON KEY_UP:
  SET_DIRECTION UP
END
ON KEY_DOWN:
  SET_DIRECTION DOWN
END
ON KEY_LEFT:
  SET_DIRECTION LEFT
END
ON KEY_RIGHT:
  SET_DIRECTION RIGHT
END